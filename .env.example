# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=
APP_URL=

# SERPER_API_KEY: Optional - if provided, the app will query Serper.dev Google Search API directly.
# If omitted, the app autonomously uses Google Search Grounding via Gemini.
SERPER_API_KEY=

